<div class="container mt-5">
  <div class="row">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header bg-primary text-white">
          <h1 class="card-title mb-0">Detalhes da Rota</h1>
        </div>
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-md-6">
              <h5>Origem</h5>
              <p><strong><%= @rota.municipio_origem.nome %></strong></p>
            </div>
            <div class="col-md-6">
              <h5>Destino</h5>
              <p><strong><%= @rota.municipio_destino.nome %></strong></p>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <h5>Horário de Saída</h5>
              <p><strong><%= @rota.horario_saida.strftime("%H:%M") %></strong></p>
            </div>
            <div class="col-md-6">
              <h5>Horário de Chegada</h5>
              <p><strong><%= @rota.horario_chegada.strftime("%H:%M") %></strong></p>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <h5>Dia da Semana</h5>
              <p><strong><%= @rota.weekday.name %></strong></p>
            </div>
            <div class="col-md-6">
              <h5>Duração</h5>
              <p><strong>
                <% duration = (@rota.horario_chegada - @rota.horario_saida).to_i / 3600 %>
                <%= "#{duration}h #{((@rota.horario_chegada - @rota.horario_saida).to_i % 3600) / 60}min" %>
              </strong></p>
            </div>
          </div>

          <% if @rota.onibuses.any? %>
            <div class="mb-3">
              <h5>Ônibus Disponíveis</h5>
              <div class="list-group">
                <% @rota.onibuses.each do |onibus| %>
                  <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between">
                      <h6 class="mb-1"><%= onibus.placa %></h6>
                      <small><%= onibus.modelo %></small>
                    </div>
                    <p class="mb-1"><small>Assentos: <%= onibus.numero_assentos %></small></p>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <% if @rota.motoristas.any? %>
            <div class="mb-3">
              <h5>Motoristas</h5>
              <div class="list-group">
                <% @rota.motoristas.each do |motorista| %>
                  <div class="list-group-item">
                    <h6 class="mb-1"><%= motorista.nome %></h6>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-3">
        <%= link_to "Ver Mapa da Rota", rota_trajetoria_path(@rota), class: "btn btn-primary" %>
        <%= link_to "Voltar", onibuses_path, class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
</div>

<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    #map { 
      height: 500px; 
      width: 100%;
      z-index: 1;
    }
  </style>
<% end %>

<div class="container">
  <h1>Mapa da Rota</h1>
  <div id="map"></div>
</div>

<%= javascript_include_tag "maps/onibuses_routes_map" %>