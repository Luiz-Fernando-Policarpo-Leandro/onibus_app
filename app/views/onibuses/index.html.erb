<div class="container-lg py-4">
  <!-- Header with Notice -->
  <div class="row mb-4">
    <div class="col-12">
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i>
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <div class="d-flex justify-content-between align-items-center">
        <h1 class="h2 fw-bold text-dark">
          <i class="bi bi-bus-front-fill"></i>
          Gerenciar Ônibus
        </h1>
        <%= link_to "Novo Ônibus", new_onibus_path, class: "btn btn-primary btn-lg rounded-3" %>
      </div>
    </div>
  </div>

  <!-- Ônibus Cards Grid -->
  <% if @onibuses.any? %>
    <div class="row g-4">
      <% @onibuses.each do |onibus| %>
        <div class="col-md-6 col-lg-4">
          <div class="card shadow-sm border-0 rounded-4 h-100 transition-transform" style="transition: transform 0.3s ease, box-shadow 0.3s ease;">
            <div class="card-header bg-primary text-white rounded-top-4">
              <h5 class="card-title mb-0 fw-bold">
                <i class="bi bi-bus-front"></i>
                <%= onibus.placa || "Ônibus" %>
              </h5>
            </div>

            <div class="card-body">
              <div class="mb-2">
                <small class="text-secondary">Modelo:</small>
                <p class="text-dark fw-500"><%= onibus.modelo || "Não informado" %></p>
              </div>

              <div class="mb-2">
                <small class="text-secondary">Capacidade:</small>
                <p class="text-dark fw-500">
                  <i class="bi bi-people-fill"></i>
                  <%= onibus.capacidade || "---" %> lugares
                </p>
              </div>

              <div class="mb-2">
                <small class="text-secondary">Rotas:</small>
                <p class="text-dark fw-500">
                  <% if onibus.rotas&.any? %>
                    <%= onibus.rotas.count %> rota(s)
                  <% else %>
                    <span class="text-danger">Nenhuma rota</span>
                  <% end %>
                </p>
              </div>

              <div>
                <small class="text-secondary">Status:</small>
                <p>
                  <span class="badge bg-success">Ativo</span>
                </p>
              </div>
            </div>

            <div class="card-footer bg-light rounded-bottom-4 border-top-0">
              <div class="d-flex gap-2">
                <%= link_to "", onibus_path(onibus), class: "btn btn-sm btn-outline-primary flex-grow-1", title: "Visualizar" do %>
                  <i class="bi bi-eye"></i>
                  Visualizar
                <% end %>
                
                <%= link_to "", edit_onibus_path(onibus), class: "btn btn-sm btn-outline-warning flex-grow-1", title: "Editar" do %>
                  <i class="bi bi-pencil"></i>
                  Editar
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="row">
      <div class="col-12">
        <div class="alert alert-info d-flex align-items-center rounded-3" role="alert">
          <i class="bi bi-info-circle me-2"></i>
          <div>
            <strong>Nenhum ônibus cadastrado.</strong>
            <p class="mb-0 mt-1">Comece criando um novo ônibus para gerenciar as rotas.</p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
  .card {
    animation: fadeIn 0.5s ease-out;
  }

  .card:hover {
    transform: translateY(-8px);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.15) !important;
  }

  .card-header {
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
  }

  .btn-outline-primary:hover,
  .btn-outline-warning:hover {
    transform: translateY(-2px);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .row.g-4 {
      --bs-gutter-x: 1rem;
    }
  }
</style>
