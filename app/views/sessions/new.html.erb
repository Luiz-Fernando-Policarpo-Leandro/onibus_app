<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
  <div class="row w-100" style="max-width: 450px;">
    <div class="col-12">
      <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-5">
          <!-- Header -->
          <div class="text-center mb-4">
            <div class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
              <i class="bi bi-bus-front text-white" style="font-size: 2rem;"></i>
            </div>
            <h1 class="h3 mt-3 fw-bold text-dark">Alagoas Transportes</h1>
            <p class="text-secondary">Faça login na sua conta</p>
          </div>

          <!-- Form -->
          <%= form_with(scope: :session, url: login_path, local: true) do |f| %>
            <!-- Email Field -->
            <div class="mb-3">
              <%= f.label :email, "Email", class: "form-label fw-500" %>
              <%= f.email_field :email, value: "adm@gmail.com", class: "form-control form-control-lg rounded-3 border-2", placeholder: "seu@email.com", required: true %>
            </div>

            <!-- Password Field -->
            <div class="mb-3">
              <%= f.label :password, "Senha", class: "form-label fw-500" %>
              <%= f.password_field :password, value: "@AdmPassword123", class: "form-control form-control-lg rounded-3 border-2", placeholder: "Sua senha", required: true %>
            </div>

            <!-- Remember Me -->
            <div class="mb-4 form-check">
              <%= f.check_box :remember_me, { value: "1", class: "form-check-input" } %>
              <%= f.label :remember_me, "Lembrar-me por 30 dias", class: "form-check-label" %>
            </div>

            <!-- Submit Button -->
            <div class="d-grid gap-2">
              <%= f.submit "Entrar", class: "btn btn-primary btn-lg rounded-3 fw-bold" %>
            </div>

            <!-- Divider -->
            <div class="my-4 d-flex align-items-center">
              <hr class="flex-grow-1" />
              <span class="px-2 text-secondary small">ou</span>
              <hr class="flex-grow-1" />
            </div>

            <!-- Password Recovery -->
            <div class="text-center">
              <%= link_to "Esqueceu sua senha?", password_reset_path, class: "text-primary text-decoration-none fw-500" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Footer Info -->
      <div class="text-center mt-4 text-secondary small">
        <p>Proteção de dados garantida com criptografia de ponta a ponta</p>
      </div>
    </div>
  </div>
</div>

<style>
  .form-control:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
  }

  .form-control-lg {
    padding: 0.75rem 1.25rem;
  }

  .btn-lg {
    padding: 0.75rem 1.5rem;
  }

  .rounded-3 {
    border-radius: 1rem !important;
  }

  .rounded-4 {
    border-radius: 1.5rem !important;
  }

  .card {
    animation: slideUp 0.5s ease-out;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
